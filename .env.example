# MongoDB Atlas Configuration
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/klink_db?retryWrites=true&w=majority"
MONGODB_DB_NAME="klink_db"

# Redis Connection Config
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Temporal.io Orchestration Config
TEMPORAL_HOST="localhost:7233"
TEMPORAL_NAMESPACE="default"

# gRPC C++ Core Engine Config
CPP_ENGINE_HOST="localhost"
CPP_ENGINE_PORT=50051

# Qdrant Vector Database Config
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Stripe Payment Config
STRIPE_API_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# LLM API Credentials (RAG & AI Director)
OPENAI_API_KEY="sk-..."
COHERE_API_KEY="co-..."
GEMINI_API_KEY="..."

# Application Settings
ENVIRONMENT="local" # Options: local, staging, production
AUTH_JWT_SECRET="your_jwt_secret_key"
AUTH_JWT_ALG="HS256"
AUTH_JWT_EXP_MINUTES=60

# New Auth Configuration
JWT_SECRET="your_jwt_secret_key_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# SMTP Settings for OTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your_email@gmail.com"
SMTP_PASSWORD="your_smtp_app_password"
SMTP_SENDER="your_email@gmail.com"

